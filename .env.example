# Jina：构建和查询 RAG 向量索引时必填。
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4

# Kimi：生成最终自然语言回答时必填；只做索引和检索评测时可留空。
MOONSHOT_API_KEY=
KIMI_CHAT_MODEL=kimi-k2.5

# 默认关闭，避免一次普通检索额外调用聊天模型。
ENABLE_LLM_PREFERENCE_MAPPER=false

# Development and tests use the in-memory LangGraph checkpointer by default.
# For a local Docker PostgreSQL checkpoint run, set these shell values before
# starting FastAPI. Supply LANGGRAPH_POSTGRES_PASSWORD from your private .env
# or shell; do not commit a concrete password or DSN.
# Required in production and shared with Java's app.internal-api.token property.
# Supply the real value from a private .env or secret store; do not commit it.
APP_INTERNAL_API_TOKEN=

# Python only rejects oversized declared chat request bodies. Java/the gateway
# remains responsible for distributed per-user rate limiting.
MAX_CHAT_REQUEST_BYTES=262144

# Phase 2 dependency resilience and safe streaming defaults.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
RAG_TIMEOUT_SECONDS=20
STREAM_SAFETY_TAIL_CHARS=64

# AI_RUNTIME_ENV=production
# LANGGRAPH_CHECKPOINTER_BACKEND=postgres
# LANGGRAPH_CHECKPOINTER_DSN=postgresql://langgraph:${LANGGRAPH_POSTGRES_PASSWORD}@localhost:${LANGGRAPH_POSTGRES_HOST_PORT}/langgraph
