# Jina：构建和查询 RAG 向量索引时必填。
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4

# Kimi：生成最终自然语言回答时必填；只做索引和检索评测时可留空。
MOONSHOT_API_KEY=
KIMI_CHAT_MODEL=kimi-k2.5

# 默认关闭，避免一次普通检索额外调用聊天模型。
ENABLE_LLM_PREFERENCE_MAPPER=false

# Java 调用 Python 业务接口时必填；必须与 Java 的 APP_AI_PYTHON_INTERNAL_TOKEN 一致。
APP_AI_PYTHON_INTERNAL_TOKEN=replace-with-a-long-random-secret
